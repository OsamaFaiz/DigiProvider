# DigiProvider Website Environment Variables Example
# Copy this file to .env.local or .env for local custom configuration

# Port for the Vite development server (default: 8443)
PORT=8443

# Host for the development server (default: 0.0.0.0)
FIGMA_DEV_SERVER_HOST=0.0.0.0

# Optional public URL / base path if hosted on a subpath (e.g. https://example.com/subpath)
# FIGMA_PUBLIC_URL=
